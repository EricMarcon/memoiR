Package: memoiR
Title: R Markdown and Bookdown Templates to Publish Documents
Version: 1.3-1.9000
URL: https://ericmarcon.github.io/memoiR/, https://github.com/EricMarcon/memoiR/
BugReports: https://github.com/EricMarcon/memoiR/issues/
Authors@R: 
  person(given = "Eric",
